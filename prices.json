#!/usr/bin/env python3
"""
ТЕХНО LIVE — Обновление прайса
================================
Читает Google таблицу → применяет наценки → сохраняет prices.json

Запуск:
  python update_prices.py

Требования:
  pip install requests
"""

import json
import requests
import re
from datetime import datetime

# ══ НАСТРОЙКИ ══
APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwZ4mSXuNHc1F1BifCcd-8vK3G8gpF2qmBg2Pk3fCYevrOfZ7E1_UybHDikG_hFes1nwA/exec'

MARKUPS = {
    'iPhone':    4000,
    'Samsung':   4000,
    'Xiaomi':    4000,
    'Watch':     3000,
    'AirPods':   2000,
    'iPad':      4000,
    'MacBook':   4000,
    'Наушники':  2000,
    'Геймпад':   3000,
    'Игры':      2000,
    'Аксессуары': 0,
}

CAT_ICONS = {
    'iPhone':'📱', 'Samsung':'📱', 'Xiaomi':'📱', 'Watch':'⌚',
    'AirPods':'🎧', 'iPad':'📟', 'MacBook':'💻', 'Наушники':'🎧',
    'Геймпад':'🎮', 'Игры':'🎮', 'Аксессуары':'🔌'
}

def normalize_photo_url(url):
    if not url:
        return None
    match = re.search(r'/file/d/([a-zA-Z0-9_-]+)', url)
    if match:
        return f'https://drive.google.com/uc?export=view&id={match.group(1)}'
    return url if url.startswith('http') else None

def load_from_apps_script():
    print('📥 Загружаю прайс из Google таблицы...')
    try:
        res = requests.get(APPS_SCRIPT_URL, allow_redirects=True, timeout=30)
        res.raise_for_status()
        raw = res.json()
        print(f'✅ Получено товаров: {len(raw)}')
        return raw
    except Exception as e:
        print(f'❌ Ошибка загрузки: {e}')
        return []

def build_prices(raw):
    products = []
    for i, p in enumerate(raw):
        name     = str(p.get('family', '')).strip()
        cat      = str(p.get('brand', '')).strip()
        memory   = str(p.get('memory', '—')).strip()
        color    = str(p.get('color', '—')).strip()
        sim      = str(p.get('sim', '—')).strip()
        price    = int(p.get('price', 0))
        old_price = p.get('oldPrice')
        photo    = normalize_photo_url(p.get('photo'))
        flag     = str(p.get('flag', '🇷🇺')).strip()
        badge    = p.get('badge') or None
        in_stock = p.get('inStock', True)
        trend    = p.get('trend', False)

        if not name or not cat or price == 0:
            continue

        icon = CAT_ICONS.get(cat, '📦')

        products.append({
            'id':        i + 1,
            'brand':     cat,
            'family':    name,
            'memory':    memory,
            'color':     color,
            'sim':       sim,
            'basePrice': price,
            'price':     price,  # наценка уже добавлена в Apps Script
            'oldPrice':  int(old_price) if old_price else None,
            'icon':      icon,
            'flag':      flag,
            'photo':     photo,
            'trend':     bool(trend),
            'badge':     badge,
            'rating':    4.8,
            'reviews':   0,
            'inStock':   bool(in_stock)
        })

    return products

def save_json(products):
    output = {
        'updated': datetime.now().strftime('%Y-%m-%d %H:%M'),
        'count': len(products),
        'products': products
    }
    with open('prices.json', 'w', encoding='utf-8') as f:
        json.dump(output, f, ensure_ascii=False, indent=2)
    print(f'💾 Сохранено в prices.json ({len(products)} товаров)')
    return output

def embed_into_html(output, html_path='index.html'):
    """Встраивает прайс прямо в index.html — мгновенная загрузка без запросов"""
    import re
    if not os.path.exists(html_path):
        print(f'⚠️  {html_path} не найден — пропускаем встройку')
        return
    with open(html_path, 'r', encoding='utf-8') as f:
        html = f.read()
    compact = json.dumps(output, ensure_ascii=False, separators=(',', ':'))
    new_line = f'const INLINE_PRICES = {compact};\n'
    if 'const INLINE_PRICES' in html:
        html = re.sub(r'const INLINE_PRICES = \{.*?\};\n', new_line, html, flags=re.DOTALL)
    else:
        html = html.replace('const GSHEETS_URL', new_line + 'const GSHEETS_URL')
    with open(html_path, 'w', encoding='utf-8') as f:
        f.write(html)
    print(f'⚡ Прайс встроен в {html_path} ({len(compact)//1024}KB)')

def main():
    print('=' * 45)
    print('  ТЕХНО LIVE — Обновление прайса')
    print('=' * 45)

    raw = load_from_apps_script()
    if not raw:
        print('❌ Не удалось загрузить данные')
        return

    products = build_prices(raw)
    output = save_json(products)
    embed_into_html(output)  # встраиваем в HTML автоматически

    print()
    print('✅ Готово! Теперь:')
    print('   git add prices.json index.html')
    print('   git commit -m "update prices"')
    print('   git push')
    print()
    print('   Цены загружаются мгновенно — без запросов.')

if __name__ == '__main__':
    main()
